<UserControl x:Class="GmEcuSimulator.Views.BinReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:replay="clr-namespace:Common.Replay;assembly=EcuSim.Common">
    <UserControl.Resources>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
            <StackPanel>
                <!-- Row 1: load actions + state pill + elapsed -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="加载…"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding LoadFileCommand}"
                            Margin="0,0,8,0"
                            ToolTip="打开由配套 GM DataLogger 生成的 .bin 文件。通道头包含名称、单位、地址、节点类型、大小、数据类型、标量、偏移量。"/>
                    <Button Grid.Column="1" Content="加载合成演示"
                            Command="{Binding LoadDemoCommand}"
                            Margin="0,0,8,0"
                            ToolTip="加载确定性的 4 通道内存 bin（RPM/TPS/冷却液/变速箱温度）。用于在真实 bin 加载器完成前连接启动/停止钩子。"/>
                    <Button Grid.Column="2" Content="卸载"
                            Command="{Binding UnloadCommand}"/>

                    <Border Grid.Column="4"
                            Background="{DynamicResource Bg.SurfaceBrush}"
                            BorderBrush="{DynamicResource Border.SubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="10,3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource Accent.PrimaryBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StateLabel}"
                                       Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="•" Margin="10,0" Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Text.TertiaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ElapsedSummary}"
                                       Style="{StaticResource Text.Mono}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 2: file path and channel summary -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="文件"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding FilePathLabel}"
                               Style="{StaticResource Text.Mono}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="•"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Text.TertiaryBrush}"
                               Margin="10,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding ChannelSummary}"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Row 3: loop mode + autoload -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="循环模式"
                               Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{x:Static replay:BinReplayLoopModeDisplay.All}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              SelectedValue="{Binding LoopMode}"
                              MinWidth="140"
                              ToolTip="保持最后值：在最后一个样本处冻结。循环：循环到开头。停止：在 bin 结束时转换为已停止。"/>
                    <Rectangle Width="1" Margin="16,4" Fill="{DynamicResource Border.SubtleBrush}"/>
                    <CheckBox Content="应用启动时自动加载"
                              IsChecked="{Binding AutoLoadOnStart}"
                              VerticalAlignment="Center"
                              ToolTip="将加载的 bin 路径保存在 ecu_config.json 中，并在下次启动时重新加载。"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Channels}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ECU"     Binding="{Binding EcuLabel}"   Width="220"/>
                <DataGridTextColumn Header="地址" Binding="{Binding AddressHex}" Width="90"/>
                <DataGridTextColumn Header="名称"    Binding="{Binding Name}"       Width="*" MinWidth="160"/>
                <DataGridTextColumn Header="单位"    Binding="{Binding Unit}"       Width="70"/>
                <DataGridTextColumn Header="大小"    Binding="{Binding SizeBytes}"  Width="60"/>
                <DataGridTextColumn Header="实时值"    Binding="{Binding LiveValue}"  Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
