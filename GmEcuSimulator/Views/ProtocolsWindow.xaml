<Window x:Class="GmEcuSimulator.Views.ProtocolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:GmEcuSimulator.Converters"
        Title="支持的协议"
        Icon="/Resources/app.ico"
        Height="760" Width="820"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource Window.Dialog}"
        Background="{DynamicResource Chrome.BgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <DockPanel LastChildFill="True"
               Background="{DynamicResource Bg.BaseBrush}">

        <!-- Custom titlebar (matches the main shell / ThemedMessageBox) -->
        <Grid DockPanel.Dock="Top" Background="{DynamicResource Chrome.GradientBrush}" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                       Style="{StaticResource Text.Body}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"/>
            <Button Grid.Column="1"
                    Style="{StaticResource Button.ChromeClose}"
                    Width="46" Height="32"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnCloseClicked"
                    ToolTip="关闭">
                <Path Data="{StaticResource Icon.Close}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.2"
                      Width="10" Height="10"/>
            </Button>
        </Grid>

        <!-- Footer: overall tally + legend -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Chrome.BgBrush}"
                BorderBrush="{DynamicResource Border.SubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding OverallSummary}"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Text.SecondaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="True" IsHitTestVisible="False" Focusable="False"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="已响应" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Text.SecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,18,0"/>
                    <CheckBox IsChecked="False" IsHitTestVisible="False" Focusable="False"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="始终 NRC" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Text.SecondaryBrush}"
                               VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Intro strip -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Bg.BaseBrush}"
                Padding="18,14,18,6">
            <StackPanel>
                <TextBlock Text="支持的协议和服务"
                           Style="{StaticResource Text.Title}"/>
                <TextBlock Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Text.SecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="此模拟器响应内容的规范注册表。列出每个协议定义的每个服务；勾选框表示应用有正向（非 NRC）响应路径，空框表示请求始终以否定响应回答。框为只读。"/>
            </StackPanel>
        </Border>

        <!-- Protocol sections -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,6,18,12">
            <ItemsControl ItemsSource="{Binding Protocols}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,8">
                            <StackPanel>
                                <!-- Section header: title + support stat -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource Text.Subtitle}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Summary}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Foreground="{DynamicResource Text.SecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,12,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Accent.SubtleBrush}"
                                            CornerRadius="4"
                                            Padding="8,3">
                                        <TextBlock Text="{Binding SupportSummary}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Foreground="{DynamicResource Text.PrimaryBrush}"/>
                                    </Border>
                                </Grid>

                                <!-- Groups -> services -->
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2,0,2">
                                                <!-- Optional group sub-header (e.g. Ford Proprietary) -->
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource Text.Caption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.SecondaryBrush}"
                                                           Margin="0,8,0,4"
                                                           Visibility="{Binding HasHeader, Converter={StaticResource BoolToVis}}"/>
                                                <ItemsControl ItemsSource="{Binding Services}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource Border.DividerBrush}"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="32"/>
                                                                        <ColumnDefinition Width="56"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- Read-only support checkbox -->
                                                                    <CheckBox Grid.Column="0"
                                                                              IsChecked="{Binding Implemented, Mode=OneWay}"
                                                                              IsHitTestVisible="False"
                                                                              Focusable="False"
                                                                              VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding SidLabel}"
                                                                               Style="{StaticResource Text.Mono}"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Name}"
                                                                               Style="{StaticResource Text.Body}"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
