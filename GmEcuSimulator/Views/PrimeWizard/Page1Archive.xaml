<UserControl x:Class="GmEcuSimulator.Views.PrimeWizard.Page1Archive"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14">
    <UserControl.Resources>
        <Style x:Key="Caption14" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical" Margin="0,12">
        <TextBlock Text="选择您希望模拟器遵循的 DPS 编程存档 (.zip)。"
                   Style="{StaticResource Caption14}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Button Content="浏览存档..."
                HorizontalAlignment="Left"
                MinWidth="200"
                Padding="14,8"
                Command="{Binding PickArchiveCommand}"/>

        <Border Margin="0,16,0,0"
                Padding="14"
                CornerRadius="4"
                BorderBrush="{DynamicResource Border.SubtleBrush}"
                BorderThickness="1"
                Background="{DynamicResource Chrome.BgBrush}"
                Visibility="{Binding IsArchiveLoaded, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="存档：" Style="{StaticResource Caption14}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ArchiveBaseName}" FontFamily="Consolas"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="实用文件：" Style="{StaticResource Caption14}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UtilityFileName}" Margin="0,6,0,0" FontFamily="Consolas"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="校准文件：" Style="{StaticResource Caption14}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CalCount}" Margin="0,6,0,0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="OS 部件号：" Style="{StaticResource Caption14}" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OsPartNumber, FallbackValue=(none)}" Margin="0,6,0,0" FontFamily="Consolas"/>
            </Grid>
        </Border>

        <Border Margin="0,16,0,0"
                Padding="14"
                CornerRadius="4"
                BorderBrush="Red"
                BorderThickness="1"
                Background="#22FF0000"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="Red"/>
        </Border>
    </StackPanel>
</UserControl>
