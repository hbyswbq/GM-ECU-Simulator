<UserControl x:Class="GmEcuSimulator.Views.PrimeWizard.Page2Phase3Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="14">
    <UserControl.Resources>
        <Style x:Key="Caption14" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>
    <DockPanel LastChildFill="True">

        <TextBlock DockPanel.Dock="Top"
                   TextWrapping="Wrap"
                   Style="{StaticResource Caption14}"
                   Margin="0,12,0,8">
            DPS will perform these reads after the cal flash completes. The Value column is what the simulator will return for each read. Rows marked "bytecode" are pinned by the archive's $53 COMPARE_DATA literals - don't change them or DPS will reject the response. Fill empty rows manually, from a bin, or auto-populated.
        </TextBlock>

        <!-- Action buttons row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="从 bin 加载..."
                    MinWidth="170"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Command="{Binding LoadFromBinCommand}"
                    ToolTip="遍历供体/同级 ECU bin 并用遍历器的真实字节序列填充非字节码行。"/>
            <Button Content="自动填充空行"
                    MinWidth="200"
                    Padding="10,6"
                    Command="{Binding AutoPopulateCommand}"
                    ToolTip="用合理的默认值填充每个空行（正确长度，已知 DID 的合理形状）。"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Margin="0,0,0,8"
                Padding="10,6"
                CornerRadius="3"
                BorderBrush="{DynamicResource Border.SubtleBrush}" BorderThickness="1"
                Background="{DynamicResource Chrome.BgBrush}"
                Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0"
                Padding="10,6"
                CornerRadius="3"
                BorderBrush="Red" BorderThickness="1"
                Background="#22FF0000"
                Visibility="{Binding HasEmptyCompared, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding EmptyComparedText}" Foreground="Red" FontWeight="Bold"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0"
                Padding="10,6"
                CornerRadius="3"
                BorderBrush="Red" BorderThickness="1"
                Background="#22FF0000"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>
        </Border>

        <DataGrid ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  IsReadOnly="False"
                  FontSize="14">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <!-- Rows that will fail Phase 3 (Empty source + has downstream
                             $53 compare) get a pinkish wash so they're easy to spot
                             alongside the footer warning. -->
                        <DataTrigger Binding="{Binding ShowWarningIcon}" Value="True">
                            <Setter Property="Background" Value="#33FF0000"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="步骤"   Binding="{Binding Step}"           IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="读取"   Binding="{Binding DidOrPidDisplay}" IsReadOnly="True" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="来源" Binding="{Binding SourceDisplay}"  IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="长度" Binding="{Binding Length}"         IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="值（十六进制，可编辑）"
                                    Binding="{Binding ValueHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <!-- Material popup-style editor (floating textbox with
                             underline). Style defined in GMThemeManager's
                             DataGrid theme via the MaterialDesignThemes merge. -->
                        <Style TargetType="TextBox"
                               BasedOn="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
