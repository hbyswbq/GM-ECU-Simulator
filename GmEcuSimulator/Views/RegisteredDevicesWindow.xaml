<Window x:Class="GmEcuSimulator.Views.RegisteredDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="已注册的 J2534 设备"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{StaticResource Window.Dialog}">

    <DockPanel LastChildFill="True">

        <!-- Custom titlebar (matches the main shell) -->
        <Grid DockPanel.Dock="Top" Background="{DynamicResource Chrome.GradientBrush}" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ChromeTitle"
                       Text="已注册的 J2534 设备"
                       Style="{StaticResource Text.Body}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"/>
            <Button Grid.Column="1"
                    Style="{StaticResource Button.ChromeClose}"
                    Width="46" Height="32"
                    Click="OnCloseClicked"
                    ToolTip="关闭">
                <Path Data="{StaticResource Icon.Close}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.2"
                      Width="10" Height="10"/>
            </Button>
        </Grid>

        <!-- Footer with close button -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Chrome.BgBrush}"
                BorderBrush="{DynamicResource Border.SubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Button HorizontalAlignment="Right"
                    Content="关闭"
                    IsCancel="True" IsDefault="True"
                    Click="OnCloseClicked"
                    MinWidth="90"/>
        </Border>

        <!-- Subtitle / explanation -->
        <Border DockPanel.Dock="Top" Padding="14,12,14,10">
            <StackPanel>
                <TextBlock x:Name="SubtitleBlock"
                           Text="J2534 设备注册表"
                           Style="{StaticResource Text.Subtitle}"/>
                <TextBlock x:Name="DescriptionBlock"
                           Text="ShimInstaller\List.ps1 的输出 - 本机注册的每个 J2534 PassThru 设备，包括两种位数。只读诊断。"
                           Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Log output -->
        <Border Margin="14,0,14,12"
                CornerRadius="4"
                BorderBrush="{DynamicResource Border.SubtleBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <TextBox x:Name="OutputBox"
                     Style="{StaticResource TextBox.Log}"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"/>
        </Border>
    </DockPanel>
</Window>
