<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GmEcuSimulator.Converters"
        xmlns:views="clr-namespace:GmEcuSimulator.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:glitch="clr-namespace:Common.Glitch;assembly=EcuSim.Common"
        xmlns:common="clr-namespace:Common;assembly=EcuSim.Common"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="GmEcuSimulator.MainWindow"
        x:Name="EcuSimMainWindow"
        Title="{Binding WindowTitle, FallbackValue=GM ECU Simulator}"
        Icon="/Resources/app.ico"
        Height="900" Width="1130"
        WindowStartupLocation="CenterScreen"
        BorderBrush="Black" BorderThickness="1">
        
        <!--MinHeight="810" MinWidth="600"-->

    <Window.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolToVis"/>
        <conv:BoolToGridLengthConverter  x:Key="BoolToGridLength"/>
        <conv:StatusToBrushConverter     x:Key="StatusToBrush"/>
        <conv:AppModeDisplayConverter    x:Key="AppModeDisplay"/>

        <!-- Carries the Window's DataContext (the MainViewModel) into resource
             scope so the live-tile picker Popup - whose content lives in a
             separate visual tree where RelativeSource AncestorType=Window can't
             reach - can bind back to the VM via Source={StaticResource VmProxy}.
             Standard WPF Freezable-proxy workaround (see BindingProxy.cs). -->
        <views:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <!--
            Validation error template. Draws a 1px red border around the
            adorned input and surfaces the first error message as a tooltip.
            Applied to inspector textboxes via local Validation.ErrorTemplate.
            The error binding goes through AdornedElement so it picks up the
            validation message that INotifyDataErrorInfo raised.
        -->
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="placeholder">
                    <Border BorderBrush="#E04848" BorderThickness="1"/>
                </AdornedElementPlaceholder>
            </StackPanel>
        </ControlTemplate>

        <!--
            Implicit TextBox augmentation: when the binding raises a
            validation error, show the red border template above and copy
            the first error message into the TextBox's ToolTip so hovering
            the field explains what's wrong. BasedOn keeps the theme-supplied
            base style intact (font, padding, brushes) so the only change is
            the added validation behaviour.
        -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ValidationErrorTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Window.AppShell"/>
    </Window.Style>

    <DockPanel LastChildFill="True">

        <!--
            TITLEBAR.
            Custom chrome. The first 36 pixels are draggable via
            WindowChrome.CaptionHeight; interactive zones (menu, status pill,
            window buttons) opt out via IsHitTestVisibleInChrome=True.
        -->
        <Grid DockPanel.Dock="Top" Background="{DynamicResource Chrome.GradientBrush}" Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand / title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="3"
                        Background="{DynamicResource Accent.PrimaryBrush}"
                        Margin="0,0,8,0">
                    <TextBlock Text="G" Foreground="White"
                               FontFamily="{StaticResource Font.SansDisplay}"
                               FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding WindowTitle, FallbackValue=GM ECU Simulator}"
                           Style="{StaticResource Text.Body}"
                           Foreground="{DynamicResource Text.PrimaryBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Centre: status pills. Security state of the selected ECU
                 (left) + J2534 device registration state (right). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Selected-ECU security pill: only renders when an ECU is
                     selected. Text comes from EcuViewModel.SecurityStatusText
                     which the main refresh tick updates 10x/sec, so it stays
                     in sync with $27 traffic without extra wiring. -->
                <Border CornerRadius="11"
                        Background="{DynamicResource Bg.SurfaceBrush}"
                        BorderBrush="{DynamicResource Border.SubtleBrush}"
                        BorderThickness="1"
                        Padding="10,3" Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="{Binding ShowsSecurityPill, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                        ToolTip="$27 安全访问状态。绿色=已解锁，黄色=已锁定，红色=锁定中。">
                    <StackPanel Orientation="Horizontal" DataContext="{Binding SelectedEcu}">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                 Fill="{Binding SecurityStatusText, Converter={StaticResource StatusToBrush}, FallbackValue={x:Null}, TargetNullValue={x:Null}}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SecurityPillText, FallbackValue='未加载 ECU', TargetNullValue='No ECU primed'}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Active-connection status pill (live, accent-coloured dot + text).
                     Shows J2534 shim registration state, or the raw-CAN TCP gauge
                     link state, depending on the selected connection type. -->
                <Border CornerRadius="11"
                        Background="{DynamicResource Bg.SurfaceBrush}"
                        BorderBrush="{DynamicResource Border.SubtleBrush}"
                        BorderThickness="1"
                        Padding="10,3" Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="当前连接状态：J2534 shim 注册或原始 CAN TCP 仪表链接。">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                 Fill="{Binding ConnectionStatus, Converter={StaticResource StatusToBrush}}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Text.PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Right: window controls -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="MinimizeBtn"
                        Style="{StaticResource Button.Chrome}"
                        Click="OnMinimizeClicked"
                        ToolTip="最小化">
                    <Path Data="{StaticResource Icon.Minimize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.2"
                          Width="10" Height="10"/>
                </Button>
                <Button x:Name="MaximizeBtn"
                        Style="{StaticResource Button.Chrome}"
                        Click="OnMaximizeClicked"
                        ToolTip="最大化">
                    <Path x:Name="MaxIcon"
                          Data="{StaticResource Icon.Maximize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.2"
                          Width="10" Height="10"/>
                </Button>
                <Button x:Name="CloseBtn"
                        Style="{StaticResource Button.ChromeClose}"
                        Click="OnCloseWindowClicked"
                        ToolTip="关闭">
                    <Path Data="{StaticResource Icon.Close}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.2"
                          Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MENU BAR + MODE SELECTOR.
             Menu items flow from the left; the top-level mode selector
             (ECU Simulator / DPS Write / DPS Read) is pinned to the
             right edge so the user can see at a glance which world they're
             in. Mode scopes single-vs-multi-ECU, per-mode persistence, and
             which tabs surface below. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Bg.BaseBrush}"
                BorderBrush="{DynamicResource Border.SubtleBrush}"
                BorderThickness="0,0,0,1"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Menu Grid.Column="0" Padding="6,2" Background="Transparent">
                <MenuItem Header="文件(_F)">
                    <MenuItem Header="新建(_N)"      Command="{Binding NewCommand}"    InputGestureText="Ctrl+N"/>
                    <MenuItem Header="打开…(_O)"    Command="{Binding OpenCommand}"   InputGestureText="Ctrl+O"/>
                    <Separator/>
                    <MenuItem Header="保存(_S)"     Command="{Binding SaveCommand}"   InputGestureText="Ctrl+S"/>
                    <MenuItem Header="另存为…(_A)" Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                    <Separator Visibility="{Binding ShowsPrimeMenu, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="清除已加载的存档(_L)"    Command="{Binding ClearPrimeArchiveCommand}"
                              Visibility="{Binding ShowsPrimeMenu, Converter={StaticResource BoolToVis}}"
                              ToolTip="清除已保存的加载路径。不会从当前总线移除 ECU。"/>
                    <Separator/>
                    <MenuItem Header="退出(_X)"     Click="OnExitClicked"/>
                </MenuItem>
                <MenuItem Header="J2534(_J)">
                    <MenuItem Header="注册为 J2534 设备…(_R)"
                              Command="{Binding RegisterJ2534Command}"
                              ToolTip="写入 J2534 注册表项。触发 UAC 提示。"/>
                    <MenuItem Header="取消注册(_U)"
                              Command="{Binding UnregisterJ2534Command}"
                              ToolTip="仅移除 GmEcuSim 项；不影响其他厂商。触发 UAC 提示。"/>
                    <Separator/>
                    <MenuItem Header="显示已注册设备…(_S)"
                              Command="{Binding ShowRegisteredDevicesCommand}"
                              ToolTip="列出本机两个注册表视图中的所有 J2534 设备。只读 - 无需 UAC。"/>
                    <Separator/>
                    <MenuItem Header="重置 IPC 管道(_I)"
                              Command="{Binding ResetIpcPipeCommand}"
                              ToolTip="停止并重启命名管道服务器。已连接的主机下次调用时会看到管道断开；新的 PassThruOpen 调用将再次成功。无需 UAC。"/>
                    <Separator/>
                    <MenuItem Header="驱动硬件 $3E 保活(_H)"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              IsChecked="{Binding AllowPeriodicTesterPresent, Mode=TwoWay}"
                              ToolTip="开启时，模拟器代表主机为通过 PassThruStartPeriodicMsg 注册的帧驱动 $3E TesterPresent。关闭时接受注册但跳过滴答 - 委托主机必须自行保持 P3C 会话活跃。"/>
                </MenuItem>
                <MenuItem Header="ECU(_E)">
                    <!-- Per-ECU Save / Load moved to the ECU Editor window's
                         toolbar (was: PID Setup). Same commands are still on
                         MainViewModel; only the menu surface here was retired
                         to keep this menu focused on bus-wide actions. -->
                    <!-- Open the ECU Editor (modal). Dumb launcher - doesn't
                         pre-target an ECU; the editor's own ECUs sidebar drives
                         selection. Add / Remove / Save / Load ECU all live in
                         the editor's own toolbar. Was the gear button on the
                         retired ECU sidebar. Always visible regardless of
                         simulator mode so the editor stays one click away
                         even while DPS / Flash Tool flows are running. -->
                    <MenuItem Header="打开 ECU 设置…(_S)"
                              Command="{Binding OpenSetupWindowCommand}"
                              ToolTip="打开 ECU 编辑器。也可以在那里添加/移除/保存/加载 ECU。"/>
                    <Separator/>
                    <MenuItem Header="重置 ECU 状态(_R)"
                              Command="{Binding ResetStateCommand}"
                              ToolTip="对每个 ECU 断电重启：清除编程会话、安全解锁、下载缓冲区和 DPID 调度。"/>
                </MenuItem>
                <!-- Developer-only escape hatches. The sidebar Add button now
                     prompts for a bin file (see MainViewModel.AddEcuFromBin);
                     'Add blank ECU' here keeps the legacy synthetic-defaults
                     path available for tests, quick setups, and DPS-free
                     debugging where a real readback isn't to hand. -->
                <MenuItem Header="工具(_T)">
                    <MenuItem Header="开发者(_D)">
                        <MenuItem Header="添加空白 ECU(_B)"
                                  Command="{Binding AddBlankEcuCommand}"
                                  ToolTip="使用 EcuIdentitySeeder 的合成默认值创建新 ECU。与侧边栏'添加 ECU'按钮在非 DPS 模式下的操作相同；保留在此以便快速访问。通过编辑器的高级选项卡从闪存读回导入真实标识。"/>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="日志(_L)">
                    <!-- Master gate. When unchecked, the four items below grey
                         out (their IsEnabled is bound to IsFileLoggingEnabled).
                         StaysOpenOnClick=True on every IsCheckable item keeps
                         the menu open so the user can flip several toggles at
                         once without re-opening the menu each time. -->
                    <MenuItem x:Name="LogToFileCheck"
                              Header="记录到文件(_L)"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              IsChecked="{Binding IsFileLoggingEnabled, Mode=TwoWay}"
                              ToolTip="在专用后台线程上将每条总线+诊断行流式传输到 CSV 文件。独立于'记录流量'文本框门控 - 当高容量下载使文本框不实用时使用。"/>
                    <MenuItem Header="打开文件夹…(_O)"
                              Click="OnOpenLogFolderClicked"
                              ToolTip="在资源管理器中打开日志目录。"/>
                    <Separator/>
                    <MenuItem Header="包含 J2534 调用(_J)"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              IsChecked="{Binding LogIncludeJ2534Calls, Mode=TwoWay}"
                              IsEnabled="{Binding IsFileLoggingEnabled}"
                              ToolTip="开启时，管道级 J2534 调用写入文件。文本框/下载选项卡镜像不受影响。"/>
                    <MenuItem Header="包含总线流量(_B)"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              IsChecked="{Binding LogIncludeBusTraffic, Mode=TwoWay}"
                              IsEnabled="{Binding IsFileLoggingEnabled}"
                              ToolTip="开启时，每个 CAN 帧（收发，包括主机过滤的）写入文件。文本框不受影响。"/>
                    <MenuItem Header="附加描述标签(_A)"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              IsChecked="{Binding LogAppendDescriptionTag, Mode=TwoWay}"
                              IsEnabled="{Binding IsFileLoggingEnabled}"
                              ToolTip="为每条总线帧行添加简短的人类可读标签（例如'SecurityAccess - RequestSeed'）。标签由 UdsAnnotator 从原始字节生成。"/>
                    <MenuItem Header="折叠批量传输(_C)"
                              IsCheckable="True"
                              StaysOpenOnClick="True"
                              IsChecked="{Binding LogCollapseBulkTransfers, Mode=TwoWay}"
                              IsEnabled="{Binding IsFileLoggingEnabled}"
                              ToolTip="压缩总线日志中的长 ISO-TP 传输：显示前3+后3个连续帧，中间替换为单个折叠标记。折叠窗口内的 FC/TesterPresent 噪音也被抑制。阈值为10个连续帧 - 较短的传输正常记录。"/>
                </MenuItem>
                <!-- Theme picker promoted to top-level. The previous "View"
                     wrapper only existed to host this submenu + the Setup-
                     window launcher; the launcher now lives under the ECU menu
                     ("Open ECU settings"), so View collapsed into a single
                     Theme entry and that's now its own top-level menu. -->
                <MenuItem Header="主题(_T)" x:Name="ThemeMenu"
                          ToolTip="切换配色方案。将您自己的 .xaml 调色板放入 Palettes 目录即可在此列出。"/>
                <!-- About. The version line is stamped at build time from the
                     git tag (see GmEcuSimulator.csproj StampVersionFromGit /
                     AppInfo.cs), so it always matches the GitHub release the
                     binary was built from. Clicking it opens the full About
                     dialog; the releases item jumps to the GitHub page the
                     version is keyed to. -->
                <MenuItem Header="关于(_A)">
                    <MenuItem Header="协议…(_P)"
                              Click="OnProtocolsClicked"
                              ToolTip="显示此应用支持的每个协议和服务，以及哪些有响应"/>
                    <Separator/>
                    <MenuItem Header="{Binding AppVersionDisplay, FallbackValue=Version}"
                              Click="OnAboutClicked"
                              ToolTip="显示版本和项目详情"/>
                    <Separator/>
                    <MenuItem Header="在 GitHub 上查看发布…(_V)"
                              Click="OnViewReleasesClicked"
                              ToolTip="在浏览器中打开 GitHub 发布页面"/>
                </MenuItem>
            </Menu>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="模式"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Text.SecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox Width="200"
                              ItemsSource="{Binding AvailableModes}"
                              SelectedItem="{Binding SelectedModeOption, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              ToolTip="顶层模式和连接类型。切换会清除当前 ECU 集合并重新初始化总线；离开可持久化模式时会先提示保存。">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATUS BAR (bottom) -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Text.PrimaryBrush}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PrimeArchiveDisplay}" Style="{StaticResource Text.MonoDim}"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               ToolTip="当前从存档加载状态。在 DPS 模式下通过 ECU 面板的添加按钮设置。"/>
                    <TextBlock Text="管道" Style="{StaticResource Text.Caption}" Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="\\.\pipe\GmEcuSim.PassThru" Style="{StaticResource Text.MonoDim}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!--
            MAIN WORKSPACE.
            Two rows split by a horizontal GridSplitter. The "Maximize"
            checkbox in the bus-log tab collapses the editor row AND
            the outer margin / splitter so the tabbed workspace fills
            edge-to-edge.
        -->
        <Grid x:Name="MainContentGrid" Margin="14">
            <Grid.RowDefinitions>
                <!-- EditorRow MinHeight is the editor area's floor when the
                     user drags the horizontal splitter up. Floor budget:
                     card chrome + Selected-ECU title + ~2 form rows in the
                     WrapPanel ScrollViewer. Maximize toggles it to 0 from
                     code-behind so the row can fully collapse - the constant
                     in MainWindow.xaml.cs (EditorMinHeightNormal) restores
                     it and must stay in sync with this value. -->
                <RowDefinition x:Name="EditorRow" Height="*" MinHeight="240"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="LogRow"    Height="320" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- EDITOR (Row 0).
                 PIDs + Waveform live in the modeless SetupWindow (open via
                 the ECU menu's "Open ECU settings"). The former ECU-list
                 sidebar was retired - SelectedEcu is seeded programmatically
                 on load / add / remove (MainViewModel), so this row is just
                 the Selected ECU inspector spanning the full width. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Selected-ECU dashboard card. Sole occupant of the row
                     now that PIDs + Waveform AND the per-ECU settings form
                     (Name / CAN IDs / FC.BS / Diag addr / Sec module /
                     Scenario) live in the modeless setup window - the latter
                     relocated to the "ECU settings" section above the mode
                     datagrids, and the "Selected ECU" header + "Edit prime..."
                     button moved across with them. What remains here is the
                     live PID tile dashboard. Bin-related actions (Load Info
                     From Bin / Auto-populate DIDs) moved out to the top-level
                     Bin menu; the in-card $1A Identifiers grid was retired with
                     them. -->
                <Border Grid.Column="0" Style="{StaticResource Card}"
                        DataContext="{Binding SelectedEcu}"
                        MinHeight="240"
                        Visibility="{Binding ConverterParameter=NotNull, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <!-- Single-row Grid holding the live PID tile dashboard.
                             The row is "*" so the panel fills the card when the
                             dashboard is visible (ECU Simulator) and collapses to
                             Auto (-> 0, since the panel's own Visibility is also
                             gated) in DPS modes. The "Selected ECU" header and the
                             "Edit prime..." button moved to the setup window's
                             "ECU settings" section with the rest of the relocated
                             per-ECU fields. ElementName binding to the Window is
                             used because RowDefinition isn't in the visual tree,
                             so RelativeSource AncestorType doesn't reach it. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{Binding DataContext.ShowsPidLiveGrid,
                                                                ElementName=EcuSimMainWindow,
                                                                Converter={StaticResource BoolToGridLength},
                                                                ConverterParameter=*|Auto}"
                                               MinHeight="{Binding DataContext.PidRowMinHeight,
                                                                   ElementName=EcuSimMainWindow}"/>
                            </Grid.RowDefinitions>

                                <!-- Live PID panel. A dashboard of tiles, each pinned to one PID
                                     (cross-ECU - the source ECU is named on the tile). The set and
                                     its order are owned by MainViewModel.LiveTiles, persisted per
                                     config as SimulatorConfig.LiveTiles. Tiles are read-only;
                                     values update off the MainWindow 10 Hz refresh timer via the
                                     bound Pid.LiveValue. The + button opens a picker popup; tiles
                                     reorder by drag (see MainWindow.xaml.cs) and delete via their
                                     right-click context menu. Hidden in DPS modes - see
                                     MainViewModel.ShowsPidLiveGrid. Bindings reach the VM through
                                     VmProxy because the enclosing card's DataContext is the
                                     SelectedEcu, not the MainViewModel. -->
                                <Border Grid.Row="0"
                                        Margin="0,8,0,0"
                                        Padding="8"
                                        CornerRadius="4"
                                        BorderBrush="{DynamicResource Border.SubtleBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource Chrome.BgBrush}"
                                        Visibility="{Binding DataContext.ShowsPidLiveGrid, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="PID 列表"
                                                       Style="{StaticResource Text.Subtitle}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Data.LiveTiles.Count, Source={StaticResource VmProxy}, StringFormat=\{0\} pinned}"
                                                       Style="{StaticResource Text.Caption}"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>

                                            <!-- + add-tile button; opens the picker popup. -->
                                            <Button Grid.Column="2"
                                                    x:Name="AddTileButton"
                                                    Style="{StaticResource Button.Icon}"
                                                    Click="AddTileButton_Click"
                                                    ToolTip="将 PID 固定到仪表板">
                                                <Path Data="M 8 1 L 8 15 M 1 8 L 15 8"
                                                      Stroke="{DynamicResource Text.PrimaryBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="16" Height="16"
                                                      Stretch="Uniform"
                                                      SnapsToDevicePixels="True"/>
                                            </Button>

                                            <!-- PID picker. Optional ECU source dropdown (only when
                                                 >1 ECU), a name/id filter, and the candidate list.
                                                 All bound through VmProxy because the popup content
                                                 is in its own visual tree. -->
                                            <Popup x:Name="PidPickerPopup"
                                                   PlacementTarget="{Binding ElementName=AddTileButton}"
                                                   Placement="Bottom"
                                                   HorizontalOffset="-180"
                                                   AllowsTransparency="True"
                                                   StaysOpen="False"
                                                   PopupAnimation="Fade"
                                                   IsOpen="{Binding Data.PickerOpen, Source={StaticResource VmProxy}, Mode=TwoWay}">
                                                <Border Background="{DynamicResource Bg.ElevatedBrush}"
                                                        BorderBrush="{DynamicResource Border.StrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="3"
                                                        Padding="8"
                                                        Width="300"
                                                        SnapsToDevicePixels="True">
                                                    <StackPanel>
                                                        <!-- Top row split in two: source ECU (left, only
                                                             shown when >1 ECU) and the mode filter (right,
                                                             defaults to Mode $01). -->
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ComboBox Grid.Column="0"
                                                                      Height="32"
                                                                      Margin="0,0,3,0"
                                                                      ItemsSource="{Binding Data.Ecus, Source={StaticResource VmProxy}}"
                                                                      SelectedItem="{Binding Data.PickerSelectedEcu, Source={StaticResource VmProxy}}"
                                                                      DisplayMemberPath="Name"
                                                                      Visibility="{Binding Data.ShowsPickerEcuDropdown, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}"/>
                                                            <ComboBox Grid.Column="1"
                                                                      Height="32"
                                                                      Margin="3,0,0,0"
                                                                      ItemsSource="{Binding Data.PickerModes, Source={StaticResource VmProxy}}"
                                                                      SelectedItem="{Binding Data.PickerSelectedMode, Source={StaticResource VmProxy}}"
                                                                      DisplayMemberPath="Display"
                                                                      ToolTip="按诊断模式筛选"/>
                                                        </Grid>
                                                        <TextBox Margin="0,0,0,6"
                                                                 Text="{Binding Data.PickerFilterText, Source={StaticResource VmProxy}, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="按 PID ID 或名称筛选"/>
                                                        <ListBox x:Name="PickerList"
                                                                 MaxHeight="240"
                                                                 ItemsSource="{Binding Data.PickerCandidates, Source={StaticResource VmProxy}}"
                                                                 DisplayMemberPath="Display"
                                                                 MouseDoubleClick="PickerList_MouseDoubleClick"/>
                                                        <Button Margin="0,6,0,0"
                                                                HorizontalAlignment="Right"
                                                                Style="{StaticResource Button.Primary}"
                                                                Content="添加"
                                                                Command="{Binding Data.AddTileCommand, Source={StaticResource VmProxy}}"
                                                                CommandParameter="{Binding SelectedItem, ElementName=PickerList}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>

                                        <!-- Tile host. WrapPanel so tiles flow and wrap; the
                                             code-behind attaches drag-reorder to this ItemsControl
                                             (AllowDrop + the InsertionAdorner). -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="LiveTileItems"
                                                          AllowDrop="True"
                                                          Background="Transparent"
                                                          ItemsSource="{Binding Data.LiveTiles, Source={StaticResource VmProxy}}"
                                                          PreviewMouseLeftButtonDown="LiveTileItems_PreviewMouseLeftButtonDown"
                                                          PreviewMouseMove="LiveTileItems_PreviewMouseMove"
                                                          DragOver="LiveTileItems_DragOver"
                                                          DragLeave="LiveTileItems_DragLeave"
                                                          Drop="LiveTileItems_Drop">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="150" Height="86"
                                                                Margin="0,0,8,8"
                                                                Padding="8,6"
                                                                CornerRadius="6"
                                                                Background="{DynamicResource Bg.SurfaceBrush}"
                                                                BorderBrush="{DynamicResource Border.SubtleBrush}"
                                                                BorderThickness="1"
                                                                Cursor="SizeAll">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="删除"
                                                                              Command="{Binding RemoveCommand}"/>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <!-- Row 0: source ECU (soft accent). Accent.Subtle is a
                                                                     near-background fill (invisible as text), so use the
                                                                     brighter Accent.Hover tone for legibility. -->
                                                                <TextBlock Text="{Binding EcuName}"
                                                                           Style="{StaticResource Text.Caption}"
                                                                           Foreground="{DynamicResource Accent.HoverBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <!-- Row 1: friendly name. -->
                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding FriendlyName}"
                                                                           Style="{StaticResource Text.Body}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding FriendlyName}"/>
                                                                <!-- Row 2: large value + small unit. The value column
                                                                     is bounded (*) so long identity payloads (e.g. a
                                                                     17-char VIN) trim with an ellipsis + full-value
                                                                     tooltip instead of overflowing the tile. -->
                                                                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding LiveValue}"
                                                                               FontFamily="{StaticResource Font.Mono}"
                                                                               FontSize="22"
                                                                               Foreground="{DynamicResource Text.PrimaryBrush}"
                                                                               VerticalAlignment="Bottom"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding LiveValue}"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Unit}"
                                                                               Margin="4,0,0,2"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource Text.SecondaryBrush}"
                                                                               VerticalAlignment="Bottom"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                        </Grid>
                    </Border>
            </Grid>

            <!-- Horizontal splitter (Row 1) -->
            <GridSplitter x:Name="EditorSplitter" Grid.Row="1" Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Margin="0,6"
                          Background="Transparent">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="{x:Type GridSplitter}">
                        <Border Background="Transparent">
                            <Rectangle Height="1" Fill="{DynamicResource Border.SubtleBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       SnapsToDevicePixels="True"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- TABBED WORKSPACE (Row 2) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Bg.SurfaceBrush}"
                    BorderBrush="{DynamicResource Border.SubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <TabControl x:Name="BusLogTabControl" Margin="0">
                    <!-- Bus log tab -->
                    <TabItem Header="总线日志">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="LogTrafficCheck"
                                              Content="记录流量"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsLoggingEnabled, Mode=TwoWay}"
                                              ToolTip="总线日志和下载选项卡镜像的主门控。默认关闭 - 在 $AA 快速 25Hz 下，仅总线帧就可能迅速淹没文本框。"/>
                                    <Button Content="清除" Click="OnClearLogClicked"
                                            Margin="16,0,0,0"/>
                                    <Rectangle Width="1" Margin="12,4" Fill="{DynamicResource Border.SubtleBrush}"/>
                                    <!-- File-log status only. The Log-to-file toggle and Open-folder
                                         button moved to the Log menu (top-level) so all file-log
                                         controls live in one place. The live status counter stays
                                         here so the user can see byte/line totals at a glance. -->
                                    <TextBlock Text="{Binding FileLogStatus, FallbackValue=Not logging}"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource Font.Mono}"
                                               Foreground="{DynamicResource Text.SecondaryBrush}"
                                               ToolTip="文件记录状态。在日志菜单下切换'记录到文件'以启动/停止接收器。"/>
                                    <Rectangle Width="1" Margin="12,4" Fill="{DynamicResource Border.SubtleBrush}"/>
                                    <CheckBox x:Name="MaximizeBusLogCheck"
                                              Content="最大化"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsMaximized, Mode=TwoWay}"
                                              ToolTip="折叠 ECU/PID 编辑器并用工作区选项卡填满窗口。与下载选项卡的最大化切换共享。"/>
                                    <CheckBox x:Name="HideTesterPresentCheck"
                                              Content="隐藏 $3E"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding SuppressTesterPresentInWindow, Mode=TwoWay}"
                                              ToolTip="仅在此日志窗口中隐藏 TesterPresent 保活。文件记录捕获不受影响。"/>
                                    <CheckBox x:Name="HideBroadcastsCheck"
                                              Content="隐藏广播"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding SuppressBroadcastsInWindow, Mode=TwoWay}"
                                              ToolTip="仅在此日志窗口中隐藏周期性 DBC 广播帧。文件记录捕获不受影响。"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="LogBoxColumn"     Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition x:Name="IpcLogBoxColumn"  Width="*"/>
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0">
                                    <Border DockPanel.Dock="Top"
                                            Background="{DynamicResource Bg.ElevatedBrush}"
                                            BorderBrush="{DynamicResource Border.SubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6"
                                                     Fill="{DynamicResource Accent.PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="CAN 帧"
                                                       Style="{StaticResource Text.Caption}"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="发送 / 接收"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox x:Name="LogBox"
                                             Style="{StaticResource TextBox.Log}"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"/>
                                </DockPanel>

                                <GridSplitter x:Name="BusLogSplitter"
                                              Grid.Column="1" Width="6"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Background="Transparent"
                                              MouseDoubleClick="OnBusLogSplitterDoubleClick"
                                              ToolTip="拖动以调整 CAN 帧/J2534 调用窗格大小。双击重置为 50/50 分割。">
                                    <GridSplitter.Template>
                                        <ControlTemplate TargetType="{x:Type GridSplitter}">
                                            <Border Background="Transparent">
                                                <Rectangle Width="1" Fill="{DynamicResource Border.SubtleBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </GridSplitter.Template>
                                </GridSplitter>

                                <DockPanel Grid.Column="2">
                                    <Border DockPanel.Dock="Top"
                                            Background="{DynamicResource Bg.ElevatedBrush}"
                                            BorderBrush="{DynamicResource Border.SubtleBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6"
                                                     Fill="{DynamicResource Status.SuccessBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="J2534 调用"
                                                       Style="{StaticResource Text.Caption}"
                                                       Foreground="{DynamicResource Text.PrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="控制平面"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox x:Name="IpcLogBox"
                                             Style="{StaticResource TextBox.Log}"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"/>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </TabItem>
<!-- (Download tab removed) -->

                    <!-- Bin Replay tab - ECU Simulator mode only -->
                    <TabItem Header="Bin 回放"
                             Visibility="{Binding ShowsBinReplayTab, Converter={StaticResource BoolToVis}}">
                        <views:BinReplayView DataContext="{Binding BinReplay}"/>
                    </TabItem>

                    <!-- (Security tab removed - reset moved to ECU > Reset state) -->

                    <!-- Glitch settings tab - ECU Simulator mode only -->
                    <TabItem Header="故障注入设置"
                             Visibility="{Binding ShowsGlitchTab, Converter={StaticResource BoolToVis}}">
                        <DockPanel DataContext="{Binding SelectedEcu}" LastChildFill="True">
                            <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ECU"
                                               Style="{StaticResource Text.Caption}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name, FallbackValue=（未选择）}"
                                               Style="{StaticResource Text.Body}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Rectangle Width="1" Margin="16,3" Fill="{DynamicResource Border.SubtleBrush}"/>
                                    <CheckBox Content="启用故障注入"
                                              IsChecked="{Binding Glitch.Enabled}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="准备中 - 尚未接入总线逻辑"
                                               Style="{StaticResource Text.Hint}"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>

                                <DataGrid Grid.Column="0"
                                          ItemsSource="{Binding Glitch.Services}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          BorderThickness="0,0,1,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="服务"
                                                            Binding="{Binding ServiceLabel}"
                                                            IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="概率 %"
                                                            Binding="{Binding ProbabilityPercent, UpdateSourceTrigger=LostFocus}"
                                                            EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnPopupEditingStyle}"
                                                            Width="120"/>
                                        <DataGridTemplateColumn Header="动作" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{StaticResource ComboBox.Cell}"
                                                              ItemsSource="{x:Static glitch:GlitchActionDisplay.All}"
                                                              DisplayMemberPath="Value"
                                                              SelectedValuePath="Key"
                                                              SelectedValue="{Binding Action, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Column="1" Padding="14,12">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="NRC 池"
                                                   Style="{StaticResource Text.Subtitle}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Text="当触发“发送NRC”时，从勾选的条目中随机选择一个 NRC。"
                                                   Style="{StaticResource Text.Hint}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <StackPanel>
                                            <CheckBox Content="$11 服务不支持"     IsChecked="{Binding Glitch.IncludeNrc11}" Margin="0,4"/>
                                            <CheckBox Content="$12 子功能不支持" IsChecked="{Binding Glitch.IncludeNrc12}" Margin="0,4"/>
                                            <CheckBox Content="$22 条件不正确"    IsChecked="{Binding Glitch.IncludeNrc22}" Margin="0,4"/>
                                            <CheckBox Content="$31 请求超出范围"   IsChecked="{Binding Glitch.IncludeNrc31}" Margin="0,4"/>
                                            <CheckBox Content="$33 安全访问被拒绝" IsChecked="{Binding Glitch.IncludeNrc33}" Margin="0,4"/>
                                            <CheckBox Content="$78 忙，响应待定"   IsChecked="{Binding Glitch.IncludeNrc78}" Margin="0,4"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <!-- Captures tab. Captures are written unconditionally;
                         this tab is a browser/launcher for the files.
                         Service36Handler anchors on the first $36 address so
                         real-DPS absolute-address sessions work without any
                         toggle. -->
                    <TabItem Header="捕获文件"
                             Visibility="{Binding ShowsCaptureTab, Converter={StaticResource BoolToVis}}">
                        <DockPanel DataContext="{Binding Capture}" LastChildFill="True">
                            <Border DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="打开文件夹"
                                            Command="{Binding OpenFolderCommand}"
                                            Style="{StaticResource Button.Ghost}"
                                            Margin="0,0,8,0"/>
                                    <Button Content="刷新"
                                            Command="{Binding RefreshCommand}"
                                            Style="{StaticResource Button.Ghost}"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="18,12,18,6">
                                    <StackPanel>
                                        <TextBlock Text="捕获目录"
                                                   Style="{StaticResource Text.SectionHeader}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding CaptureDirectory}"
                                                   Style="{StaticResource Text.MonoDim}"
                                                   TextWrapping="NoWrap"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="已捕获文件"
                                                   Style="{StaticResource Text.SectionHeader}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="每一行代表一个编程会话（$34/$36 序列，以 $20 返回正常模式或 P3C 超时结束）。文件名包含 ECU 名称、UTC 时间戳、$36 基地址和字节数。"
                                                   Style="{StaticResource Text.Hint}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"/>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Captures}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          Margin="14,0,14,12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="文件"     Binding="{Binding FileName}" Width="*"/>
                                        <DataGridTextColumn Header="大小"     Binding="{Binding SizeText}" Width="100"/>
                                        <DataGridTextColumn Header="修改时间" Binding="{Binding Modified, StringFormat=g}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
