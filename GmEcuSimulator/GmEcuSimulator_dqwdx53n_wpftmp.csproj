    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Referenced directly (not just transitively via Shim) so the package's
         CopyNativeLibs_x64_Build target stages vcinet\x64\vcinet.x64.dll (+ Ijwhost.dll)
